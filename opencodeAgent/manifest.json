{
    "container": "docker.io/assistos/ploinky-node:24-bookworm-tools",
    "containerSecurity": {
        "privileged": true
    },
    "startup": "manual",
    "lite-sandbox": true,
    "about": "OpenCode CLI agent. Executes one-shot build tasks via opencode CLI to construct AKU from WAC data.",
    "profiles": {
        "default": {
            "install": "sh /code/scripts/install-opencode.sh"
        }
    },
    "health": {
        "readiness": {
            "script": "readiness.sh",
            "interval": 1,
            "timeout": 5,
            "failureThreshold": 60,
            "successThreshold": 1
        }
    },
    "endpoints": {
        "chatCompletions": {
            "command": "node",
            "args": ["/code/openai-api/chat-completions.mjs"],
            "cwd": "/code",
            "supportsStream": false
        },
        "models": {
            "command": "node",
            "args": ["/code/openai-api/models.mjs"],
            "cwd": "/code"
        }
    },
    "cli": "\"$HOME/.opencode/bin/opencode\"",
    "env": [
        "PLOINKY_WORKSPACE_ROOT",
        "OPENCODE_API_KEY",
        "XAI_API_KEY",
        "OPENCODE_API_KEY",
        "GEMINI_API_KEY",
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY"
    ]
}
