{
    "providerSandbox": {
        "provider": "opencode",
        "readiness": true
    },
    "tools": [
        {
            "name": "execute-task",
            "title": "Execute OpenCode Task",
            "description": "Execute an OpenCode build task from a caller-supplied prompt and model, persist its provider session behind an opaque continuation handle, and write artifacts in the supplied project directory.",
            "providerExecution": {
                "provider": "opencode",
                "module": "/code/scripts/execute-task.mjs",
                "export": "executeProviderTask"
            },
            "async": true,
            "taskLogRetention": "full",
            "continuationTool": "continue-task",
            "tags": ["internal"],
            "inputSchema": {
                "prompt": {
                    "type": "string",
                    "description": "Prompt to execute with opencode. The caller owns prompt construction and inclusion of any task data.",
                    "optional": false
                },
                "projectDir": {
                    "type": "string",
                    "description": "Selected non-root workspace directory where OpenCode may write task artifacts.",
                    "optional": false
                },
                "model": {
                    "type": "string",
                    "description": "OpenCode model identifier selected by the caller.",
                    "optional": true
                }
            }
        },
        {
            "name": "continue-task",
            "title": "Continue OpenCode Task",
            "description": "Continue a previously completed or failed OpenCode task through its opaque Ploinky continuation handle.",
            "command": "node",
            "args": ["/code/scripts/continue-task.mjs"],
            "cwd": "/code",
            "async": true,
            "taskLogRetention": "full",
            "tags": ["internal"],
            "inputSchema": {
                "handle": {
                    "type": "string",
                    "description": "Opaque continuation handle issued by an OpenCode task whose provider session was created.",
                    "optional": false
                },
                "prompt": {
                    "type": "string",
                    "description": "New user message to execute in the existing OpenCode session.",
                    "optional": false
                },
                "model": {
                    "type": "string",
                    "description": "Optional task-specific OpenCode model override.",
                    "optional": true
                }
            }
        },
        {
            "name": "task-session-control",
            "title": "Control OpenCode Task Session",
            "description": "Run typed provider authentication operations for an OpenCode task session.",
            "command": "node",
            "args": ["/code/scripts/task-session-control.mjs"],
            "cwd": "/code",
            "tags": ["internal"],
            "inputSchema": {
                "operation": { "type": "string", "optional": false },
                "handle": { "type": "string", "optional": false },
                "provider": { "type": "string", "optional": true },
                "method": { "type": "string", "optional": true },
                "flowId": { "type": "string", "optional": true },
                "response": { "type": "string", "optional": true },
                "apiKey": { "type": "string", "optional": true },
                "inputs": { "type": "object", "additionalProperties": true, "optional": true },
                "secretResponse": { "type": "string", "optional": true }
            }
        }
    ]
}
