{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "soul": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ploinky Soul Gateway",
            "options": {
                "baseURL": "{env:PLOINKY_TASK_BROKER_URL}",
                "apiKey": "{env:PLOINKY_TASK_BROKER_KEY}"
            },
            "models": {
                "fast": { "name": "Soul fast" },
                "plan": { "name": "Soul plan" },
                "deep": { "name": "Soul deep" }
            }
        }
    },
    "permission": {
        "*": "allow",
        "external_directory": "deny"
    }
}
