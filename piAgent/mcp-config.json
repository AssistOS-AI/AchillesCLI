{
    "tools": [
        {
            "name": "execute-task",
            "title": "Execute PI Task",
            "description": "Execute a PI coding task from a caller-supplied prompt and model and persist its provider session behind an opaque continuation handle.",
            "providerExecution": {
                "provider": "pi",
                "module": "/code/scripts/execute-task.mjs",
                "export": "executeProviderTask"
            },
            "async": true,
            "taskLogRetention": "full",
            "continuationTool": "continue-task",
            "tags": ["internal"],
            "inputSchema": {
                "prompt": {
                    "type": "string",
                    "description": "Prompt to execute with PI. The caller builds the final prompt and optional model.",
                    "optional": false
                },
                "projectDir": {
                    "type": "string",
                    "description": "Directory where PI will run.",
                    "optional": false
                },
                "model": {
                    "type": "string",
                    "description": "PI model identifier selected by the caller.",
                    "optional": true
                }
            }
        },
        {
            "name": "continue-task",
            "title": "Continue PI Task",
            "description": "Continue a previously completed or failed PI task through its opaque Ploinky continuation handle.",
            "command": "node",
            "args": ["/code/scripts/continue-task.mjs"],
            "cwd": "/code",
            "async": true,
            "taskLogRetention": "full",
            "tags": ["internal"],
            "inputSchema": {
                "handle": {
                    "type": "string",
                    "description": "Opaque continuation handle issued by a PI task whose provider session was created.",
                    "optional": false
                },
                "prompt": {
                    "type": "string",
                    "description": "New user message to execute in the existing PI session.",
                    "optional": false
                },
                "provider": {
                    "type": "string",
                    "description": "Optional task-specific PI provider override.",
                    "optional": true
                },
                "model": {
                    "type": "string",
                    "description": "Optional task-specific PI model override.",
                    "optional": true
                }
            }
        },
        {
            "name": "task-session-control",
            "title": "Control PI Task Session",
            "description": "Run typed provider authentication operations for a PI task session.",
            "command": "node",
            "args": ["/code/scripts/task-session-control.mjs"],
            "cwd": "/code",
            "tags": ["internal"],
            "inputSchema": {
                "operation": { "type": "string", "optional": false },
                "handle": { "type": "string", "optional": false },
                "provider": { "type": "string", "optional": true },
                "method": { "type": "string", "optional": true },
                "flowId": { "type": "string", "optional": true },
                "response": { "type": "string", "optional": true },
                "apiKey": { "type": "string", "optional": true },
                "inputs": { "type": "object", "additionalProperties": true, "optional": true },
                "secretResponse": { "type": "string", "optional": true }
            }
        }
    ],
    "providerSandbox": {
        "provider": "pi",
        "readiness": true
    }
}
