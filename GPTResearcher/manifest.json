{
    "container": "docker.io/assistos/bwrap-runner:node24-python-bookworm",
    "lite-sandbox": true,
    "about": "GPTResearcher agent. Runs GPT Researcher through the Python package and exposes research through a Ploinky MCP tool.",
    "readiness": {
        "protocol": "mcp"
    },
    "health": {
        "readiness": {
            "script": "readiness.sh",
            "interval": 1,
            "timeout": 5,
            "failureThreshold": 180,
            "successThreshold": 1
        }
    },
    "agent": "sh /code/scripts/start-gpt-researcher.sh",
    "profiles": {
        "default": {
            "install": "sh /code/scripts/install-gpt-researcher.sh",
            "additionalServerPort": 8000
        }
    },
    "httpServices": [
        {
            "slug": "gpt-researcher",
            "externalPrefix": "/services/gpt-researcher/",
            "internalPrefix": "/",
            "access": "authenticated"
        }
    ],
    "env": [
        "OPENAI_API_KEY",
        "TAVILY_API_KEY",
        "ANTHROPIC_API_KEY",
        "GROQ_API_KEY",
        "OPENROUTER_API_KEY",
        "DEEPSEEK_API_KEY",
        "XAI_API_KEY",
        "MISTRAL_API_KEY",
        "GOOGLE_API_KEY",
        "SOUL_GATEWAY_API_KEY",
        "OPENAI_BASE_URL"
    ],
    "ideSettings": [
        {
            "key": "gpt-researcher-settings",
            "label": "GPTResearcher",
            "scope": "workspace",
            "pluginKey": "GPTResearcher/gpt-researcher-settings",
            "settingsComponent": "gpt-researcher-settings",
            "adminOnly": false
        }
    ]
}
