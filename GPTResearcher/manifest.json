{
    "container": "docker.io/assistos/bwrap-runner@sha256:9b6c08cf78fd0a29acfbe2e45ea2ee26efe6fde49c7f3db8b3aadfa30f2d53f8",
    "startup": "manual",
    "lite-sandbox": true,
    "about": "GPTResearcher agent. Runs GPT Researcher through the Python package and exposes research through a Ploinky MCP tool.",
    "readiness": {
        "protocol": "mcp"
    },
    "health": {
        "readiness": {
            "script": "readiness.sh",
            "interval": 1,
            "timeout": 5,
            "failureThreshold": 180,
            "successThreshold": 1
        }
    },
    "agent": "sh /code/scripts/start-gpt-researcher.sh",
    "profiles": {
        "default": {
            "install": "sh /code/scripts/install-gpt-researcher.sh"
        }
    },
    "routerAccess": {
        "httpRoutes": [
            {
                "path": "/base-agent-additional-server/GPTResearcher/8000/*",
                "access": "authenticated"
            }
        ]
    },
    "ideSettings": [
        {
            "key": "gpt-researcher-settings",
            "label": "GPTResearcher",
            "scope": "workspace",
            "pluginKey": "GPTResearcher/gpt-researcher-settings",
            "settingsComponent": "gpt-researcher-settings",
            "adminOnly": false
        }
    ]
}
