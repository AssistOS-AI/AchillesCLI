{
  "tools": [
    {
      "name": "scout_status",
      "title": "Scout status",
      "description": "Monitoring state, the current and last cycle task, the last run, RSSHub health and the page and topic limits.",
      "command": "node",
      "args": [
        "tools/scout.mjs",
        "status"
      ],
      "cwd": "/code",
      "timeoutMs": 60000,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "scout_monitor_start",
      "title": "Start monitoring",
      "description": "Starts monitoring at one of the offered intervals; the first cycle starts immediately and monitoring resumes after agent restarts until it is stopped.",
      "command": "node",
      "args": [
        "tools/scout.mjs",
        "monitor-start"
      ],
      "cwd": "/code",
      "timeoutMs": 60000,
      "inputSchema": {
        "type": "object",
        "properties": {
          "intervalHours": {
            "type": "integer",
            "enum": [
              1,
              2,
              4,
              6,
              8,
              12,
              24,
              48,
              168
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "scout_monitor_stop",
      "title": "Stop monitoring",
      "description": "Stops monitoring; a running cycle aborts and keeps its run record. RSSHub keeps running.",
      "command": "node",
      "args": [
        "tools/scout.mjs",
        "monitor-stop"
      ],
      "cwd": "/code",
      "timeoutMs": 60000,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "scout_topics_list",
      "title": "List topics",
      "description": "Pages the active topics with their search terms, tags, subtopics and feed counts.",
      "command": "node",
      "args": [
        "tools/scout.mjs",
        "topics-list"
      ],
      "cwd": "/code",
      "timeoutMs": 60000,
      "inputSchema": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "scout_topic_create",
      "title": "Add topic",
      "description": "Adds a topic, or restores a removed one, with optional search terms and tags.",
      "command": "node",
      "args": [
        "tools/scout.mjs",
        "topic-create"
      ],
      "cwd": "/code",
      "timeoutMs": 60000,
      "inputSchema": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "searchTerms": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 50
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 50
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "scout_topic_update",
      "title": "Edit topic",
      "description": "Renames a topic and saves its search terms, tags and, when sent, its full subtopic list together.",
      "command": "node",
      "args": [
        "tools/scout.mjs",
        "topic-update"
      ],
      "cwd": "/code",
      "timeoutMs": 60000,
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 200
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "searchTerms": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 50
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 50
          },
          "subtopics": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "text": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "scout_topic_delete",
      "title": "Remove topic",
      "description": "Deactivates a topic; its history stays stored and adding it again restores it.",
