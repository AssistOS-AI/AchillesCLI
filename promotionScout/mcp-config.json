    {
      "name": "scout_site_add",
      "title": "Add site",
      "description": "Adds a search, tag or fixed-feed site; a web page is resolved to its advertised feed.",
      "command": "node",
      "args": [
        "tools/scout.mjs",
        "site-add"
      ],
      "cwd": "/code",
      "timeoutMs": 120000,
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "enum": [
              "search",
              "tag",
              "feed"
            ]
          },
          "template": {
            "type": "string",
            "maxLength": 2000
          },
          "tagStyle": {
            "type": "string",
            "maxLength": 40
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "scout_site_set_enabled",
      "title": "Enable or disable site",
      "description": "Enables or disables a site for future cycles.",
