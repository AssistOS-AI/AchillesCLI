      "args": [
        "tools/scout.mjs",
        "site-set-enabled"
      ],
      "cwd": "/code",
      "timeoutMs": 60000,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
