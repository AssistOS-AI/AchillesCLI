    {
      "name": "scout_results_list",
      "title": "List topic matches",
      "description": "Pages the entries that passed a topic's threshold, with new marks, site facets and sorting.",
      "command": "node",
      "args": [
        "tools/scout.mjs",
        "results-list"
      ],
      "cwd": "/code",
      "timeoutMs": 60000,
      "inputSchema": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 200
          },
          "sites": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 50
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "new": {
            "type": "boolean"
          },
          "sort": {
            "type": "string",
            "enum": [
              "new",
              "found",
              "score"
            ]
          }
