      "args": [
        "tools/scout.mjs",
        "topic-delete"
      ],
      "cwd": "/code",
      "timeoutMs": 60000,
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 200
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "scout_topic_derive",
