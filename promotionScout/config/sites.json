{
  "sites": [
    {"id": "reddit", "name": "Reddit", "kind": "search", "template": "https://www.reddit.com/search.rss?q={query}&sort=new&type=link", "joinTerms": " OR ", "delayMs": 10000, "remove": ["submitted by /u/\\S+", "\\[link\\]", "\\[comments\\]"]},
    {"id": "hackernews", "name": "Hacker News (hnrss.org)", "kind": "search", "template": "https://hnrss.org/newest?q={query}", "remove": ["Article URL: \\S+", "Comments URL: \\S+", "Points: \\d+", "# Comments: \\d+"]},
    {"id": "bluesky", "name": "Bluesky (RSSHub)", "kind": "search", "template": "/bsky/keyword/{query}"},
    {"id": "mastodon", "name": "Mastodon (mastodon.social)", "kind": "tag", "template": "https://mastodon.social/tags/{tag}.rss", "tagStyle": "joined"},
    {"id": "devto", "name": "DEV Community", "kind": "tag", "template": "https://dev.to/feed/tag/{tag}", "tagStyle": "alnum"},
    {"id": "medium", "name": "Medium", "kind": "tag", "template": "https://medium.com/feed/tag/{tag}", "tagStyle": "hyphen"},
    {"id": "lobsters", "name": "Lobsters", "kind": "tag", "template": "https://lobste.rs/t/{tag}.rss", "tagStyle": "joined", "remove": ["^Comments$"]},
    {"id": "stackoverflow", "name": "Stack Overflow", "kind": "tag", "template": "https://stackoverflow.com/feeds/tag/{tag}", "tagStyle": "hyphen"},
    {"id": "lemmy-community", "name": "Lemmy communities (lemmy.world)", "kind": "tag", "template": "https://lemmy.world/feeds/c/{tag}.xml?sort=New", "tagStyle": "underscore"},
    {"id": "producthunt", "name": "Product Hunt", "kind": "feed", "template": "https://www.producthunt.com/feed", "remove": ["Discussion \\| Link"]},
    {"id": "slashdot", "name": "Slashdot", "kind": "feed", "template": "https://rss.slashdot.org/Slashdot/slashdotMain"},
    {"id": "huggingface", "name": "Hugging Face daily papers (RSSHub)", "kind": "feed", "template": "/huggingface/daily-papers"},
    {"id": "lemmy", "name": "Lemmy (lemmy.world, all communities)", "kind": "feed", "template": "https://lemmy.world/feeds/all.xml?sort=New"},
    {"id": "ask-hn", "name": "Ask HN (hnrss.org)", "kind": "feed", "template": "https://hnrss.org/ask", "remove": ["Article URL: \\S+", "Comments URL: \\S+", "Points: \\d+", "# Comments: \\d+"]},
    {"id": "metafilter", "name": "MetaFilter", "kind": "feed", "template": "https://rss.metafilter.com/metafilter.rss"},
    {"id": "ask-metafilter", "name": "Ask MetaFilter", "kind": "feed", "template": "https://rss.metafilter.com/ask.rss"},
    {"id": "tildes", "name": "Tildes (all groups)", "kind": "feed", "template": "https://tildes.net/topics.rss"}
  ]
}
