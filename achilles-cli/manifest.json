{
  "container": "docker.io/assistos/ploinky-node:24-bookworm-tools",
  "install": "",
  "lite-sandbox": true,
  "env": [
    {
      "name": "SOUL_GATEWAY_API_KEY",
      "sharedGeneratedSecret": true,
      "explicitOverride": true
    },
    "WORKSPACE_PATH",
    "ACHILLES_MODEL_PLAN",
    "ACHILLES_MODEL_CODE",
    "ACHILLES_DEBUG"
  ],
  "repos": {
    "copilot-agents": "https://github.com/AssistOS-AI/copilot-agents.git"
  },
  "enable": [
    "copilot-agents/opencodeAgent global",
    "copilot-agents/piAgent global"
  ],
  "webchat": {
    "auth": "static"
  },
  "cli": "node /code/src/index.mjs",
  "about": "Achilles CLI for managing, generating, and testing skill definition files in skills directories."
}
