{
  "container": "docker.io/assistos/ploinky-node:24-bookworm-tools",
  "install": "",
  "lite-sandbox": true,
  "env": [
    "SOUL_GATEWAY_API_KEY",
    "WORKSPACE_PATH",
    "ACHILLES_MODEL_PLAN",
    "ACHILLES_MODEL_CODE",
    "ACHILLES_DEBUG"
  ],
  "webchat": {
    "auth": "static"
  },
  "cli": "node /code/src/index.mjs",
  "about": "Achilles CLI for managing, generating, and testing skill definition files in skills directories.",
