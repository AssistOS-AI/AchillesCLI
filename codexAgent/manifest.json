{
    "startup": "manual",
    "lite-sandbox": true,
    "about": "Codex CLI agent. Installs the official OpenAI Codex CLI, exposes it as a direct Ploinky CLI command, and provides resumable asynchronous MCP task execution.",
    "endpoints": {
        "models": {
            "command": "node",
            "args": ["/code/openai-api/models.mjs"],
            "cwd": "/code"
        }
    },
    "profiles": {
        "default": {
            "install": "sh /code/scripts/install-codex.sh"
        }
    },
    "cli": "\"$HOME/.local/bin/codex\"",
    "env": {
        "OPENAI_API_KEY": {
            "name": "OPENAI_API_KEY"
        }
    }
}
