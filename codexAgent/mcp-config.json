{
    "providerSandbox": {
        "provider": "codex",
        "readiness": true
    },
    "tools": [
        {
            "name": "execute-task",
            "title": "Execute Codex Task",
            "description": "Execute a Codex coding task and persist its provider thread behind an opaque continuation handle.",
            "providerExecution": {
                "provider": "codex",
                "mode": "task",
                "module": "/code/scripts/execute-task.mjs",
                "export": "executeProviderTask"
            },
            "async": true,
            "taskLogRetention": "full",
            "continuationTool": "continue-task",
            "tags": ["internal"],
            "inputSchema": {
                "prompt": {
                    "type": "string",
                    "description": "Prompt to execute with Codex.",
                    "optional": false
                },
                "projectDir": {
                    "type": "string",
                    "description": "Directory where Codex will run.",
                    "optional": false
                },
                "model": {
                    "type": "string",
                    "description": "Optional Codex model override for this initial task.",
                    "optional": true
                },
                "additionalProperties": false
            }
        },
        {
            "name": "continue-task",
            "title": "Continue Codex Task",
            "description": "Continue a Codex task through its opaque Ploinky continuation handle using the currently configured model.",
            "providerExecution": {
                "provider": "codex",
                "mode": "operation",
                "module": "/code/scripts/continue-task.mjs",
                "export": "continueProviderTask"
            },
            "async": true,
            "taskLogRetention": "full",
            "tags": ["internal"],
            "inputSchema": {
                "handle": {
                    "type": "string",
                    "description": "Opaque continuation handle issued by a Codex task whose provider thread was created.",
                    "optional": false
                },
                "prompt": {
                    "type": "string",
                    "description": "New user message to execute in the existing Codex thread.",
                    "optional": false
                },
                "additionalProperties": false
            }
        },
        {
            "name": "task-session-control",
            "title": "Control Codex Task Session",
            "description": "Run typed OpenAI and ChatGPT authentication operations for a Codex task session.",
            "providerExecution": {
                "provider": "codex",
                "mode": "operation",
                "module": "/code/scripts/task-session-control.mjs",
                "export": "executeTaskSessionControl"
            },
            "tags": ["internal"],
            "inputSchema": {
                "operation": { "type": "string", "optional": false },
                "handle": { "type": "string", "optional": true },
                "provider": { "type": "string", "optional": true },
                "method": { "type": "string", "optional": true },
                "flowId": { "type": "string", "optional": true },
                "continuationHandle": { "type": "string", "optional": true },
                "seq": { "type": "number", "optional": true },
                "nonce": { "type": "string", "optional": true },
                "response": { "type": "string", "optional": true },
                "apiKey": { "type": "string", "optional": true },
                "additionalProperties": false
            }
        }
    ]
}
